<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="color-scheme" content="light" />
    <meta name="supported-color-schemes" content="light" />
    <title>{{ subject }}</title>
    <style>
        body, table, td, a { -webkit-text-size-adjust: 100%; -ms-text-size-adjust: 100%; }
        table, td { mso-table-lspace: 0pt; mso-table-rspace: 0pt; }
        img { -ms-interpolation-mode: bicubic; border: 0; height: auto; line-height: 100%; outline: none; text-decoration: none; }
        @media only screen and (max-width: 600px) {
            .ew-container { width: 100% !important; border-radius: 12px !important; }
            .ew-content { padding: 24px 20px !important; }
            .ew-header { padding: 20px !important; }
            .ew-footer { padding: 20px !important; }
            .ew-btn { display: block !important; width: 100% !important; box-sizing: border-box !important; }
        }
    </style>
</head>
<body style="margin: 0; padding: 0; background-color: #E6F0FB; font-family: 'Outfit', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Arial, sans-serif; color: #0E1B2A;">
    <table role="presentation" border="0" cellpadding="0" cellspacing="0" width="100%" bgcolor="#E6F0FB" style="background-color: #E6F0FB; padding: 32px 16px;">
        <tr>
            <td align="center">
                <table role="presentation" class="ew-container" border="0" cellpadding="0" cellspacing="0" width="100%" bgcolor="#FFFFFF" style="max-width: 580px; background-color: #FFFFFF; border-radius: 18px; border: 1px solid #D3DEE9; overflow: hidden;">
                    <tr>
                        <td class="ew-header" bgcolor="#0B63B6" style="padding: 24px 32px; background-color: #0B63B6; background-image: linear-gradient(135deg, #0B63B6 0%, #09528F 100%); text-align: left;">
                            <span style="font-size: 20px; font-weight: 700; color: #FFFFFF; letter-spacing: 0.4px; text-decoration: none;">Event&#39;s World</span>
                        </td>
                    </tr>
                    <tr>
                        <td class="ew-content" bgcolor="#FFFFFF" style="padding: 32px; background-color: #FFFFFF; color: #0E1B2A;">
                            {{ content }}
                        </td>
                    </tr>
                    <tr>
                        <td class="ew-footer" bgcolor="#EBF1F7" style="padding: 24px 32px; background-color: #EBF1F7; border-top: 1px solid #D3DEE9; text-align: center;">
                            <p style="margin: 0 0 8px; font-size: 12px; color: #3E5367; line-height: 1.5;">
                                Este es un correo automático enviado por Event&#39;s World. Por favor, no respondas directamente a este mensaje.
                            </p>
                            <p style="margin: 0; font-size: 12px; color: #3E5367;">
                                &copy; {{ year }} Event&#39;s World. Todos los derechos reservados.
                            </p>
                        </td>
                    </tr>
                </table>
            </td>
        </tr>
    </table>
</body>
</html>
