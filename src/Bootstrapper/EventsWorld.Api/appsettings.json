{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning",
        "System.Net.Http.HttpClient": "Warning"
      }
    }
  },
  "AllowedHosts": "*",
  "Cors": {
    "AllowedOrigins": []
  },
  "ForwardedHeaders": {
    "KnownProxies": [],
    "KnownNetworks": []
  },
  "RateLimiting": {
    "AnonymousPermitLimit": 60,
    "AnonymousWindowSeconds": 60
  },
  "Resend": {
    "Provider": "Resend",
    "SenderEmail": "notificaciones@eventsworld.app",
    "SenderName": "Event's World",
    "SmtpHost": "localhost",
    "SmtpPort": 1025
  },
  "Notifications": {
    "WorkerEnabled": true,
    "OutboxIntervalSeconds": 5,
    "MaxAttempts": 30,
    "BatchSize": 25,
    "RetentionDays": 90
  }
}
