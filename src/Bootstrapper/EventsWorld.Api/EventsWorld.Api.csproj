<Project Sdk="Microsoft.NET.Sdk.Web">

    <PropertyGroup>
        <RootNamespace>EventsWorld.Api</RootNamespace>
        <AssemblyName>EventsWorld.Api</AssemblyName>
        <!-- Local connection strings: dotnet user-secrets (see README). -->
        <UserSecretsId>eventsworld-api</UserSecretsId>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="FluentValidation.DependencyInjectionExtensions" />
        <PackageReference Include="Microsoft.AspNetCore.OpenApi" />
        <PackageReference Include="OpenTelemetry.Extensions.Hosting" />
        <PackageReference Include="OpenTelemetry.Instrumentation.AspNetCore" />
        <PackageReference Include="OpenTelemetry.Instrumentation.Http" />
        <PackageReference Include="Scalar.AspNetCore" />
        <PackageReference Include="Serilog.AspNetCore" />
        <!-- Design-time only: lets `dotnet ef` create the module DbContexts from this host. -->
        <PackageReference Include="Microsoft.EntityFrameworkCore.Design">
            <PrivateAssets>all</PrivateAssets>
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        </PackageReference>
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\..\Shared\EventsWorld.Shared.Infrastructure\EventsWorld.Shared.Infrastructure.csproj" />
        <ProjectReference Include="..\..\Modules\Accounts\EventsWorld.Modules.Accounts\EventsWorld.Modules.Accounts.csproj" />
        <ProjectReference Include="..\..\Modules\Audit\EventsWorld.Modules.Audit\EventsWorld.Modules.Audit.csproj" />
        <ProjectReference Include="..\..\Modules\Events\EventsWorld.Modules.Events\EventsWorld.Modules.Events.csproj" />
        <ProjectReference Include="..\..\Modules\Files\EventsWorld.Modules.Files\EventsWorld.Modules.Files.csproj" />
        <ProjectReference Include="..\..\Modules\Legal\EventsWorld.Modules.Legal\EventsWorld.Modules.Legal.csproj" />
        <ProjectReference Include="..\..\Modules\Notifications\EventsWorld.Modules.Notifications\EventsWorld.Modules.Notifications.csproj" />
        <ProjectReference Include="..\..\Modules\Payments\EventsWorld.Modules.Payments\EventsWorld.Modules.Payments.csproj" />
        <ProjectReference Include="..\..\Modules\Registrations\EventsWorld.Modules.Registrations\EventsWorld.Modules.Registrations.csproj" />
    </ItemGroup>

</Project>
